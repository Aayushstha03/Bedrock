# Copy this file to .env before customizing the deployment.

# Pinned Qdrant server image.
QDRANT_IMAGE=qdrant/qdrant:v1.15.4

# Keep the dashboard/API restricted to this machine.
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_PORT=6333

# Use an absolute path for a real vault. The fixture vault is the safe default.
BEDROCK_VAULT_PATH=./tests/fixtures/vault

# Index and local embedding configuration.
BEDROCK_COLLECTION=bedrock_entries
BEDROCK_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
BEDROCK_SPARSE_MODEL=Qdrant/bm25

# Input positions the dense model accepts before it truncates. Entries are
# split on paragraph boundaries to stay inside this window, and the encoder
# tokenizer is pinned to it. 256 is what all-MiniLM-L6-v2 declares; FastEmbed
# would otherwise default it to 128. Never set this above 512.
BEDROCK_DENSE_TOKEN_WINDOW=256

# Only these first-level vault directories have note-type semantics.
BEDROCK_LOG_ROOT=logs
BEDROCK_KANBAN_ROOT=kanban

# Recursive discovery exclusions and fixed tag registry.
BEDROCK_EXCLUDED_DIRECTORIES=.git,.obsidian,.trash
BEDROCK_KNOWN_TAGS=journal,recipe,work
BEDROCK_TAG_ALIASES=journaling:journal,recipes:recipe

# LM Studio serves the answering model from the host over its OpenAI-compatible
# API. It is optional: parse, watch, and index run with LM Studio closed, so the
# index never competes for VRAM. Enable "Serve on Local Network" in LM Studio.
BEDROCK_LLM_BASE_URL=http://host.docker.internal:1234/v1
BEDROCK_LLM_MODEL=google/gemma-4-e4b
# LM Studio ignores this value, but the OpenAI client requires a non-empty one.
BEDROCK_LLM_API_KEY=lm-studio
# Seconds to wait for one answer before giving up on a stalled model.
BEDROCK_LLM_TIMEOUT=120
# Sampling temperature, 0.0 to 2.0. Zero keeps an answer as repeatable as the
# server allows, which is not the same as deterministic. Sent on every request,
# so it overrides any preset held by the LM Studio server.
BEDROCK_LLM_TEMPERATURE=0.0

# Docker restart behavior for Qdrant and Bedrock.
RESTART_POLICY=unless-stopped

# Read-only Bedrock MCP endpoint, published on loopback by default.
BEDROCK_MCP_BIND_ADDRESS=127.0.0.1
BEDROCK_MCP_PORT=8000
